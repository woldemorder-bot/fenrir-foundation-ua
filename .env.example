# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fenrir.foundation

# LiqPay (https://www.liqpay.ua/documentation/api/aquiring/checkout/doc)
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Optional: Google Tag Manager (loaded only after cookie consent)
NEXT_PUBLIC_GTM_ID=

# Supabase (https://supabase.com) — table SQL: supabase/migrations/001_donations.sql
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram alerts for successful donations (@BotFather → token, chat id from @userinfobot or group)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: CSV export GET /api/admin/donations/export (Authorization: Bearer <secret>)
DONATIONS_EXPORT_SECRET=
